# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Backend server configuration
BACKEND_PORT=5000
FRONTEND_PORT=3000
DATABASE_URL="file:./hydronexus.db"

# Security & Municipal Administrator Provisioning
JWT_SECRET="change-this-imc-hydronexus-jwt-secret"
ADMIN_SETUP_KEY="IMC-HYDRONEXUS-SETUP-2026"

# IoT Sensor Ingestion & Demonstration Mode
DATA_MODE="DEMO"
LIVE_SENSOR_API_URL=""
POLL_INTERVAL_MS=5000

# Frontend Google Maps Platform Configuration
VITE_GOOGLE_MAPS_API_KEY=""
VITE_API_BASE_URL="/api"

